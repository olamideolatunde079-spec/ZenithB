# ---- Backend (Python / FastAPI) ----
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/venv/
backend/.env
backend/.venv/

# ---- General ----
.DS_Store
*.log
*.pem
.vercel
frontend/.next
frontend/next-env.d.ts
